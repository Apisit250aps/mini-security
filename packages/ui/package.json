    "./components/shared/*": "./src/shared/*.tsx",
    "./shared/*": "./src/shared/*.tsx",
    "./shared/form": "./src/shared/form/index.ts",
    "./shared/form/*": "./src/shared/form/*.tsx",
    "./shared/dashboard": "./src/shared/dashboard/index.ts",
    "./shared/dashboard/*": "./src/shared/dashboard/*.tsx",
    "./components/shared/dashboard": "./src/shared/dashboard/index.ts",
