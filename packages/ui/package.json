    "./lib/*": "./src/lib/*.ts",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#shared/*": "./src/shared/*.tsx",
    "#form": "./src/shared/form/index.ts",
    "#form/*": "./src/shared/form/*.tsx",
    "#dashboard": "./src/shared/dashboard/index.ts",
    "#dashboard/*": "./src/shared/dashboard/*.tsx",
    "#hooks/*": "./src/hooks/*.tsx",
    "#hooks": "./src/hooks/index.ts",
