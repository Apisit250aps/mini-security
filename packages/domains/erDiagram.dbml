// Mini-Security Database Schema (DBML)
// โมดูลเดิมและแบบเสนอ Form ใช้ซ้ำ / ตารางเวลา / Role และสมาชิก / ตรวจตาม Permissions
// and implemented many-to-many Check-in Schedule / Role assignments.
// PROPOSED sections are not implemented in Drizzle or migrations yet.
// Location additions and tenant-safe attendance keys are PROPOSED; see docs/check-in-location-design.md.
// Source-only storage redesign is PROPOSED: docs/erd-storage-audit.md; runtime schema may differ.
// แบบและคำอธิบายภาษาไทย: docs/form-workflow-design.md และ docs/erd-description-th.md
// Attendance design: docs/check-in-schedule-design.md

Project mini_security {
  database_type: 'PostgreSQL'
  Note: '''
  แผนภาพข้อมูล Mini Security: ตัวตน บริษัท สิทธิ์ ฟีเจอร์ สถานที่ การเช็คอิน การลา และ Form
  ส่วน Form เป็นแบบเสนอใหม่วันที่ 2026-09-15 แยกแม่แบบ/ฉบับคำถาม แผนเวลา รอบงาน ผู้รับงาน คำตอบ และผลตรวจ
  ผู้รับงานเป็น Role ร่วมทำหรือสมาชิกรายบุคคล ผู้ตรวจใช้ Permissions ที่ tenant ตั้ง ไม่กำหนดตำแหน่งพิเศษ
  การขอแก้ภาพหรือหมวดบันทึก comment พร้อมเป้าหมาย ส่วน RETURN ทั้งชุดเปิดทางให้ส่ง revision ใหม่โดยรักษาหลักฐานเก่า
  เก็บเฉพาะข้อมูลต้นทาง การตัดสินใจ ประวัติที่สร้างกลับไม่ได้ และ integrity/concurrency keys ไม่เก็บยอดหรือสถานะที่คำนวณซ้ำได้
  คำอธิบายละเอียด: docs/erd-description-th.md; flow: docs/form-workflow-design.md; หน้าจอ: docs/form-workflow-ui-flow.md
  ยังไม่ใช่ runtime schema/migration; partial indexes และกติกา application ที่อธิบายใน docs ต้องทำเพิ่มก่อนใช้งานจริง
  '''
}

// --- Enum Definitions ---

Enum role_type {
  SUPER_ADMIN
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// --- Auth & User Management ---

Table user {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  is_admin boolean [not null, default: false]
  is_active boolean [not null, default: true]
  last_login timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    email [name: 'user_email_idx']
    is_admin [name: 'user_is_admin_idx']
  }

  Note: 'บัญชีตัวตนผู้ใช้ระดับระบบ หนึ่งคนเข้าร่วมได้หลายบริษัทผ่าน company_member เก็บข้อมูลโปรไฟล์และข้อเท็จจริงบัญชี ไม่เก็บสิทธิ์ของแต่ละบริษัทในตารางนี้'
}

Table account {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  user_id uuid [not null]
  account_id text [not null]
  provider_id text [not null]
  issuer text
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    user_id [name: 'account_user_id_idx']
    (provider_id, account_id) [name: 'account_provider_account_idx']
  }

  Note: 'ข้อมูลช่องทางเข้าสู่ระบบของ Better Auth เช่นบัญชี OAuth หรือข้อมูลรหัสผ่าน ผูกกับ user และไม่ใช้แทนสมาชิกบริษัท'
}

Table session {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  user_id uuid [not null]
  token text [not null, unique]
  expires_at timestamp [not null]
  ip_address text
  user_agent text
  active_company_id uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    token [name: 'session_token_idx']
    user_id [name: 'session_user_id_idx']
  }

  Note: 'เซสชันที่ใช้ยืนยันตัวตนและบริษัทที่เลือกอยู่ สิทธิ์ใช้งานต้องคำนวณจากสมาชิกและ Role ปัจจุบัน ไม่เก็บ permission cache'
}

Table verification {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    identifier [name: 'verification_identifier_idx']
  }

  Note: 'ข้อมูลตรวจสอบอีเมล รหัสใช้ครั้งเดียว และคำขอตั้งรหัสผ่านใหม่ เก็บค่าและเวลาหมดอายุตามกระบวนการยืนยันตัวตน'
}

Table jwks {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  public_key text [not null]
  private_key text [not null]
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp
  alg text
  crv text

  Note: 'กุญแจสำหรับลงนามและตรวจสอบ JWT ของระบบยืนยันตัวตน ไม่ใช่ข้อมูลสิทธิ์ทางธุรกิจของบริษัท'
}

// --- Multi-Tenant & Organization ---

Table company {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  name text [not null]
  slug text [not null, unique]
  logo text
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    slug [name: 'company_slug_idx']
  }

  Note: 'พื้นที่ทำงานของบริษัทและขอบเขต tenant หลัก ข้อมูลธุรกิจและสมาชิกต้องอ้างบริษัทที่ถูกต้องเพื่อไม่ให้เข้าถึงข้อมูลข้ามบริษัท'
}

Table company_branch {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_id uuid [not null]
  name text [not null]
  address text
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_id [name: 'company_branch_company_id_idx']
    (id, company_id) [unique, note: 'PROPOSED: tenant-safe location references']
  }

  Note: 'สาขาภายใต้บริษัท ใช้จัดกลุ่มสถานที่และข้อมูลปฏิบัติงาน ไม่ใช้สาขาแทน tenant boundary'
}

Table company_member {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_branch_id uuid [not null]
  company_id uuid [not null]
  user_id uuid [not null]
  role_id uuid [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_id [name: 'company_member_company_id_idx']
    user_id [name: 'company_member_user_id_idx']
    role_id [name: 'company_member_role_id_idx']
    (company_id, user_id) [name: 'company_member_company_user_idx']
    (id, company_id) [unique, name: 'company_member_id_company_unique', note: 'PROPOSED: tenant-safe actor references']
  }

  Note: 'ความสัมพันธ์ผู้ใช้กับบริษัทพร้อม Role และสถานะสมาชิก การบันทึกผู้กรอกหรือผู้ตรวจอ้างสมาชิกนี้และตรวจ user identity เมื่อต้องตรวจประวัติคนเดียวกัน'
}

// --- Access Control & Permissions (RBAC) ---

Table role {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_id uuid [note: 'Nullable for global system default roles']
  name text [not null]
  description text
  role_type role_type [not null, default: 'MEMBER']
  is_system_default boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_id [name: 'role_company_id_idx']
    is_system_default [name: 'role_is_system_default_idx']
    role_type [name: 'role_role_type_idx']
  }

  Note: 'ชุดสิทธิ์ที่บริษัทกำหนด หรือ Role ค่าเริ่มต้นระบบที่ company_id ว่าง ชื่อและ role_type ไม่ใช่เงื่อนไขพิเศษสำหรับผู้ตรวจ Form ต้องตรวจ permission ที่ได้รับจริง'
}

Table permission {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  feature_id uuid [note: 'ผูกกับ feature เพื่อจัดกลุ่มและสืบทอดสิทธิ์ (Nullable สำหรับ Core Permissions)']
  action text [not null, unique]
  module text [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    action [name: 'permission_action_idx']
    module [name: 'permission_module_idx']
    feature_id [name: 'permission_feature_id_idx']
  }

  Note: 'รายการการกระทำที่ระบบรองรับ แต่ละ tenant เลือกมอบสิทธิ์ให้ Role ได้ เช่นตรวจรายข้อ ตรวจหมวด หรือตัดสินทั้งชุด ไม่ตีความข้อความเป็นโปรแกรม workflow'
}

Table role_permission {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  role_id uuid [not null]
  permission_id uuid [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    role_id [name: 'role_permission_role_id_idx']
    permission_id [name: 'role_permission_permission_id_idx']
    (role_id, permission_id) [name: 'role_permission_unique_idx']
  }

  Note: 'ตารางเชื่อม Role กับ Permission แบบหลายต่อหลาย เป็นการมอบสิทธิ์ที่ตั้งไว้จริง ใช้ resolve สิทธิ์ปัจจุบันทุกครั้งที่ดำเนินการสำคัญ'
}

// --- Feature Management & Tenant Entitlement ---

Table feature {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  code text [not null, unique, note: 'รหัสฟีเจอร์อ้างอิงของระบบ เช่น ATTENDANCE, LEAVE_MANAGEMENT, PAYROLL']
  name text [not null, note: 'ชื่อฟีเจอร์ เช่น "ระบบลงเวลาเข้างาน", "ระบบจัดการการลา"']
  description text [note: 'คำอธิบายความสามารถของฟีเจอร์']
  category text [not null, note: 'หมวดหมู่ฟีเจอร์ เช่น "HR", "SECURITY", "FINANCE", "CORE"']
  is_active boolean [not null, default: true, note: 'สถานะเปิดใช้งานฟีเจอร์ในระดับแพลตฟอร์ม (Global Master Switch)']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    code [unique, name: 'feature_code_idx']
    category [name: 'feature_category_idx']
    is_active [name: 'feature_is_active_idx']
  }

  Note: 'Master Catalog ของฟีเจอร์ทั้งหมดในระบบ กำหนดโดย Super Admin'
}

Table company_feature {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_id uuid [not null, note: 'บริษัทที่ได้รับสิทธิ์ฟีเจอร์']
  feature_id uuid [not null, note: 'ฟีเจอร์ที่มอบหมายให้']
  is_enabled boolean [not null, default: true, note: 'Super Admin ควบคุมเปิด/ปิดการใช้งานของบริษัทนี้']
  assigned_by uuid [note: 'Super Admin User ID ผู้ทำการมอบหมาย/แก้ไข']
  expires_at timestamp [note: 'วันหมดอายุของฟีเจอร์ (สำหรับ Subscription/Trial Plan)']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_id [name: 'company_feature_company_id_idx']
    feature_id [name: 'company_feature_feature_id_idx']
    (company_id, feature_id) [unique, name: 'company_feature_company_feature_unique']
    is_enabled [name: 'company_feature_is_enabled_idx']
  }

  Note: 'การตั้งค่าสิทธิ์ฟีเจอร์ระดับบริษัท โดย Super Admin (Entitlement & Feature Toggle)'
}

Table role_feature {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_id uuid [not null, note: 'บริษัทเจ้าของ Role (ใช้ทำ Tenant Boundary Check & Fast Indexing)']
  role_id uuid [not null, note: 'Role ภายในบริษัท เช่น HR_ADMIN, SECURITY_GUARD']
  feature_id uuid [not null, note: 'ฟีเจอร์ที่มอบหมายให้ Role นี้ดูแล/เข้าถึง']
  is_enabled boolean [not null, default: true, note: 'เปิด/ปิดการเข้าถึงฟีเจอร์นี้สำหรับ Role']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_id [name: 'role_feature_company_id_idx']
    role_id [name: 'role_feature_role_id_idx']
    feature_id [name: 'role_feature_feature_id_idx']
    (role_id, feature_id) [unique, name: 'role_feature_role_feature_unique']
  }

  Note: 'การมอบหมายฟีเจอร์ให้ Role ภายในบริษัทดูแล โดย Admin ของบริษัท'
}

// --- Foreign Key Relationships ---

Ref: account.user_id > user.id [delete: cascade]
Ref: session.user_id > user.id [delete: cascade]
// Logical reference in this design; current Drizzle does not declare this FK.
Ref: session.active_company_id > company.id

Ref: company_branch.company_id > company.id [delete: cascade]
Ref: company_member.company_branch_id > company_branch.id [delete: cascade]
Ref: company_member.company_id > company.id [delete: cascade]
Ref: company_member.user_id > user.id [delete: cascade]
// Logical reference in this design; current Drizzle validates roles in use cases, not with this FK.
Ref: company_member.role_id > role.id

Ref: role.company_id > company.id [delete: cascade]
Ref: role_permission.role_id > role.id [delete: cascade]
Ref: role_permission.permission_id > permission.id [delete: cascade]

Ref: company_feature.company_id > company.id [delete: cascade]
Ref: company_feature.feature_id > feature.id [delete: cascade]
Ref: company_feature.assigned_by > user.id [delete: set null]

Ref: role_feature.company_id > company.id [delete: cascade]
Ref: role_feature.role_id > role.id [delete: cascade]
Ref: role_feature.feature_id > feature.id [delete: cascade]

Ref: permission.feature_id > feature.id [delete: set null]

// --- Table Groups for Visual Organization ---

TableGroup auth_management {
  user
  account
  session
  verification
  jwks
}

TableGroup organization_management {
  company
  company_branch
  company_member
}

TableGroup access_control {
  role
  permission
  role_permission
}

TableGroup feature_management {
  feature
  company_feature
  role_feature
}

// Location Management (proposed check-in locations)

Table locations {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null]
  company_branch_id uuid [not null]
  is_primary boolean [not null, default: false, note: 'ไม่เกินหนึ่งสถานที่หลักต่อสาขา; partial unique ใน migration']
  is_active boolean [not null, default: true]
  name text [not null]
  address text [not null]
  latitude "double precision" [not null, check: `latitude BETWEEN -90 AND 90`]
  longitude "double precision" [not null, check: `longitude BETWEEN -180 AND 180`]
  radius_meters "double precision" [not null, check: `radius_meters > 0 AND radius_meters < 'Infinity'::float8`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (id, company_id) [unique]
    (company_branch_id, company_id)
    (company_id, is_active)
  }

  checks {
    `NOT is_primary OR is_active` [name: 'location_primary_active_check']
  }

  Note: 'PROPOSED: สถานที่หลักต่อสาขาเป็นค่าเริ่มต้นใน UI เท่านั้น; สิทธิ์เช็คอินต้องมาจาก slot assignment; ปิดใช้งานแทนลบเมื่อมีประวัติ'
}

Table schedule_slot_location {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null]
  schedule_slot_id uuid [not null]
  location_id uuid [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (schedule_slot_id, location_id) [unique]
    (schedule_slot_id, location_id, company_id) [unique, note: 'รองรับ FK จากหลักฐานเช็คอิน']
    (location_id, company_id)
    (company_id, schedule_slot_id, is_active)
  }

  Note: 'PROPOSED: M:N พื้นที่ที่อนุญาตต่อ slot; เปิดคู่เดิมกลับมาใช้; ปิด assignment ไม่กระทบประวัติ'
}

Ref: schedule_slot_location.(schedule_slot_id, company_id) > schedule_slots.(id, company_id) [delete: restrict]
Ref: schedule_slot_location.(location_id, company_id) > locations.(id, company_id) [delete: restrict]
Ref: locations.company_id > company.id [delete: restrict]
Ref: locations.(company_branch_id, company_id) > company_branch.(id, company_id) [delete: restrict]

TableGroup location_management {
  locations
}

// Attendance Module (ระบบเช็คชื่อเข้างาน)
// หมายเหตุ:
// "ตำแหน่งงาน" (position) → ใช้ตาราง `role` ที่มีอยู่แล้ว
// "พนักงาน" (employee) → ใช้ตาราง `company_member` ที่มีอยู่แล้ว
// Schedule / Role เป็น M:N ผ่าน check_in_schedule_roles
// Drizzle / API / UI implemented; migration: 20260912040000_check_in_schedule_roles

Enum attendance_status {
  present [note: 'มาทำงาน']
  absent [note: 'ขาดงาน']
  late [note: 'มาสาย']
  excused [note: 'ลา (มีเหตุผล)']
}

// Schedule เป็นของบริษัท และมอบหมายให้หลาย Role ผ่านตารางกลาง
Table check_in_schedules {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_id uuid [not null, note: 'FK -> company.id — บริษัทเจ้าของ Schedule']
  name text [not null, note: 'ชื่อ schedule เช่น รอบประจำวัน, รอบตรวจช่วงเย็น']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_id [name: 'check_in_schedule_company_id_idx']
    (id, company_id) [unique, name: 'check_in_schedule_id_company_unique']
  }

  Note: 'Schedule ใช้ร่วมกันได้หลาย Role; เอา role_id และ unique เดิมออกหลังย้ายข้อมูลเข้าตารางกลาง'
}

// 1 role มีหลาย schedule และ 1 schedule มอบหมายให้หลาย role
Table check_in_schedule_roles {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_id uuid [not null, note: 'Composite FK บังคับบริษัทของ Schedule; use case ตรวจบริษัทของ Role หรือ system default']
  check_in_schedule_id uuid [not null]
  role_id uuid [not null, note: 'Role ของบริษัทเดียวกัน หรือ global role ที่ is_system_default = true']
  is_active boolean [not null, default: true, note: 'เปิด/ปิดการมอบหมายเฉพาะ Role โดยไม่กระทบ Role อื่น']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    (check_in_schedule_id, role_id) [unique, name: 'check_in_schedule_role_pair_unique']
    (company_id, role_id) [name: 'check_in_schedule_role_company_role_idx']
  }

  Note: 'M:N assignment: มีผลเมื่อทั้ง Schedule และ assignment เปิดใช้งาน; เปิดคู่เดิมกลับมาใช้แทนการเพิ่มแถวซ้ำ'
}

// แต่ละรอบการเช็คชื่อในวัน (1 schedule มีได้หลาย slot — dynamic)
Table schedule_slots {
  company_id uuid [not null, note: 'PROPOSED: backfill จาก Schedule ก่อน NOT NULL']
  id uuid [pk, note: 'UUIDv7 Primary Key']
  check_in_schedule_id uuid [not null, note: 'FK -> check_in_schedules.id']
  slot_order integer [not null, note: 'ลำดับรอบในวัน เช่น 1=เช้า 2=กลางวัน 3=เย็น']
  label text [not null, note: 'ชื่อรอบ เช่น เช้า, กลางวัน, เย็น']
  window_start time [not null, note: 'เปิดรับการเช็คตั้งแต่เวลานี้']
  window_end time [not null, note: 'ปิดรับการเช็ค']
  is_required boolean [not null, default: true, note: 'บังคับเช็คในรอบนี้หรือไม่']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    check_in_schedule_id [name: 'schedule_slot_schedule_id_idx']
    (id, company_id) [unique, note: 'PROPOSED: tenant-safe location/log references']
    (check_in_schedule_id, slot_order) [unique, name: 'schedule_slot_order_unique']
  }

  Note: '1 slot = 1 รอบการเช็คต่อวัน — เพิ่ม/ลดได้อิสระ'
}

// บันทึกการเช็คชื่อ — 1 record = 1 company_member × 1 slot × 1 วัน
Table attendance_logs {
  company_id uuid [not null, note: 'PROPOSED: backfill และตรวจบริษัทของสมาชิกกับ Slot ให้ตรงกัน']
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_member_id uuid [not null, note: 'FK -> company_member.id (company_member แทน "พนักงาน")']
  schedule_slot_id uuid [not null, note: 'FK -> schedule_slots.id — ระบุรอบที่เช็ค']
  work_date date [not null, note: 'วันที่ทำงาน']
  checked_in_at timestamp [note: 'เวลาเช็คจริง (null = ขาด / ยังไม่เช็ค)']
  status attendance_status [not null, default: 'absent']
  note text [note: 'หมายเหตุ เช่น ลาป่วย ลากิจ']
  recorded_by uuid [note: 'FK -> user.id ของ Admin/หัวหน้าที่บันทึกแทน (Nullable)']
  // PROPOSED: all-or-none snapshot; NULL for legacy, manual, absent/excused records.
  location_id uuid
  checked_in_latitude "double precision" [check: `checked_in_latitude BETWEEN -90 AND 90`]
  checked_in_longitude "double precision" [check: `checked_in_longitude BETWEEN -180 AND 180`]
  location_name_snapshot text
  location_latitude_snapshot "double precision" [check: `location_latitude_snapshot BETWEEN -90 AND 90`]
  location_longitude_snapshot "double precision" [check: `location_longitude_snapshot BETWEEN -180 AND 180`]
  radius_meters_snapshot "double precision" [check: `radius_meters_snapshot > 0 AND radius_meters_snapshot < 'Infinity'::float8`]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_member_id [name: 'attendance_log_member_id_idx']
    schedule_slot_id [name: 'attendance_log_slot_id_idx']
    work_date [name: 'attendance_log_work_date_idx']
    (company_member_id, schedule_slot_id, work_date) [unique, name: 'attendance_log_unique_per_slot_per_day']
  }

  checks {
    `num_nonnulls(location_id, checked_in_latitude, checked_in_longitude, location_name_snapshot, location_latitude_snapshot, location_longitude_snapshot, radius_meters_snapshot) IN (0, 7)` [name: 'attendance_location_snapshot_complete_check']
    `location_id IS NULL OR (checked_in_at IS NOT NULL AND status IN ('present', 'late'))` [name: 'attendance_location_event_check']
  }

  Note: '1 record = 1 company_member × 1 รอบ × 1 วัน — Unique constraint กันเช็คซ้ำ'
}

// --- Attendance Foreign Key Relationships ---

// Schedule เป็นของบริษัท; assignment บังคับ tenant ผ่าน composite FKs
Ref: check_in_schedules.company_id > company.id [delete: cascade]
Ref: check_in_schedule_roles.(check_in_schedule_id, company_id) > check_in_schedules.(id, company_id) [delete: cascade]
Ref: check_in_schedule_roles.role_id > role.id [delete: cascade]

// schedule_slots → check_in_schedules
Ref: schedule_slots.(check_in_schedule_id, company_id) > check_in_schedules.(id, company_id) [delete: cascade] // PROPOSED

// attendance_logs → company_member (พนักงาน), schedule_slots, user (ผู้บันทึกแทน)
Ref: attendance_logs.(company_member_id, company_id) > company_member.(id, company_id) [delete: restrict] // PROPOSED: preserve history
Ref: attendance_logs.(schedule_slot_id, company_id) > schedule_slots.(id, company_id) [delete: restrict] // PROPOSED
Ref: attendance_logs.(schedule_slot_id, location_id, company_id) > schedule_slot_location.(schedule_slot_id, location_id, company_id) [delete: restrict] // PROPOSED
Ref: attendance_logs.recorded_by > user.id [delete: set null]

// --- Attendance Table Group ---

TableGroup attendance_module {
  check_in_schedules
  check_in_schedule_roles
  schedule_slots
  schedule_slot_location
  attendance_logs
}

// Leave Management Module (ระบบขอลา)
// หมายเหตุ:
// "พนักงาน" → ใช้ตาราง `company_member` ที่มีอยู่แล้ว
// ตารางใหม่: leave_types, leave_quotas, leave_requests

Enum leave_request_status {
  pending [note: 'รอการอนุมัติ']
  approved [note: 'อนุมัติแล้ว']
  rejected [note: 'ปฏิเสธ']
  cancelled [note: 'ยกเลิกโดยผู้ขอ']
}

Enum leave_unit {
  day [note: 'นับเป็นวัน']
  half_day [note: 'ลาครึ่งวัน']
  hour [note: 'นับเป็นชั่วโมง']
}

// ประเภทการลา — กำหนดต่อบริษัท (ลาป่วย, ลากิจ, ลาพักร้อน ฯลฯ)
Table leave_types {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_id uuid [not null, note: 'FK -> company.id (scoped ต่อบริษัท)']
  name text [not null, note: 'ชื่อประเภทการลา เช่น ลาป่วย, ลากิจ, ลาพักร้อน']
  description text [note: 'รายละเอียดเงื่อนไขการลา']
  unit leave_unit [not null, default: 'day', note: 'หน่วยการนับ: วัน / ครึ่งวัน / ชั่วโมง']
  requires_proof boolean [not null, default: false, note: 'ต้องแนบเอกสาร/ใบรับรองแพทย์หรือไม่']
  max_days_per_year integer [note: 'วันลาสูงสุดต่อปี (null = ไม่จำกัด)']
  is_paid boolean [not null, default: true, note: 'ลาโดยได้รับค่าจ้างหรือไม่']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_id [name: 'leave_type_company_id_idx']
    (company_id, name) [unique, name: 'leave_type_company_name_unique']
  }

  Note: 'ประเภทการลาที่บริษัทกำหนด — Admin สร้าง/แก้ไขได้ dynamic'
}

// โควต้าวันลาต่อปีของสมาชิกแต่ละคน ต่อประเภทการลา
Table leave_quotas {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_member_id uuid [not null, note: 'FK -> company_member.id']
  leave_type_id uuid [not null, note: 'FK -> leave_types.id']
  year integer [not null, note: 'ปี ค.ศ. ที่ใช้ quota นี้']
  total_days decimal [not null, check: `total_days >= 0`, note: 'จำนวนสิทธิ์ที่ Admin กำหนดให้ปีนี้ ไม่ใช่ยอดรวมจากคำขอ']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_member_id [name: 'leave_quota_member_id_idx']
    leave_type_id [name: 'leave_quota_type_id_idx']
    (company_member_id, leave_type_id, year) [unique, name: 'leave_quota_member_type_year_unique']
  }

  Note: 'โควต้าวันลาต่อปีต่อคน — ใช้ track ยอดคงเหลือ'
}

// คำขอลา — 1 request = 1 ช่วงลา (อาจครอบคลุมหลายวัน)
Table leave_requests {
  id uuid [pk, note: 'UUIDv7 Primary Key']
  company_member_id uuid [not null, note: 'FK -> company_member.id (ผู้ขอลา)']
  leave_type_id uuid [not null, note: 'FK -> leave_types.id']
  start_date date [not null, note: 'วันเริ่มลา']
  end_date date [not null, note: 'วันสุดท้ายที่ลา']
  unit leave_unit [not null, default: 'day', note: 'หน่วยที่ใช้ขอลาครั้งนี้ ไม่เปลี่ยนตามประเภทลาภายหลัง']
  start_time time [note: 'PROPOSED: เวลาเริ่มสำหรับ half_day/hour ใน Asia/Bangkok']
  end_time time [note: 'PROPOSED: เวลาสิ้นสุดสำหรับ half_day/hour วันเดียวกัน']
  minutes_per_day_snapshot integer [check: `minutes_per_day_snapshot > 0 AND minutes_per_day_snapshot <= 1440`, note: 'PROPOSED: นโยบายหน่วยนาทีต่อวัน ณ เวลาขอลารายชั่วโมง ไม่ใช่ยอดคำนวณ']
  reason text [not null, note: 'เหตุผลการลา']
  proof_url text [note: 'URL เอกสาร/ใบรับรองแพทย์ (ถ้ามี)']
  status leave_request_status [not null, default: 'pending']
  reviewed_by uuid [note: 'FK -> user.id ผู้อนุมัติ/ปฏิเสธ (Nullable ก่อนตรวจ)']
  reviewed_at timestamp [note: 'เวลาที่ตรวจสอบ']
  review_note text [note: 'หมายเหตุจากผู้อนุมัติ เช่น เหตุผลปฏิเสธ']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Indexes {
    company_member_id [name: 'leave_request_member_id_idx']
    leave_type_id [name: 'leave_request_type_id_idx']
    status [name: 'leave_request_status_idx']
    (company_member_id, start_date, end_date) [name: 'leave_request_member_date_idx']
  }

  checks {
    `end_date >= start_date` [name: 'leave_request_date_order_check']
    `(unit = 'day' AND start_time IS NULL AND end_time IS NULL AND minutes_per_day_snapshot IS NULL) OR (unit = 'half_day' AND start_date = end_date AND start_time IS NOT NULL AND end_time IS NOT NULL AND end_time > start_time AND minutes_per_day_snapshot IS NULL) OR (unit = 'hour' AND start_date = end_date AND start_time IS NOT NULL AND end_time IS NOT NULL AND end_time > start_time AND minutes_per_day_snapshot IS NOT NULL)` [name: 'leave_request_source_interval_check']
  }

  Note: 'คำขอลา — มี approval flow (pending → approved/rejected) เชื่อมกับ attendance_logs ผ่าน work_date + excused status'
}

// --- Leave Management Foreign Key Relationships ---

// leave_types → company
Ref: leave_types.company_id > company.id [delete: cascade]

// leave_quotas → company_member, leave_type
Ref: leave_quotas.company_member_id > company_member.id [delete: cascade]
Ref: leave_quotas.leave_type_id > leave_types.id [delete: cascade]

// leave_requests → company_member, leave_type, reviewer (user)
Ref: leave_requests.company_member_id > company_member.id [delete: cascade]
Ref: leave_requests.leave_type_id > leave_types.id [delete: restrict]
Ref: leave_requests.reviewed_by > user.id [delete: set null]

// --- Leave Management Table Group ---

TableGroup leave_management {
  leave_types
  leave_quotas
  leave_requests
}

// แบบเสนอ 2026-09-15: ฟอร์มใช้ซ้ำ แผนเวลา งานราย Role/สมาชิก และตรวจตาม Permission
// ยังไม่ใช่ Drizzle schema หรือ migration ที่ใช้งานจริง
// คำอธิบาย: docs/erd-description-th.md และ docs/form-workflow-design.md
// Partial unique และกติกาข้ามแถว: ดูคำอธิบาย ERD ก่อน implement


Enum form_version_status {
  DRAFT [note: 'ฉบับร่าง แก้ไข section/field ได้อิสระ']
  PUBLISHED [note: 'เผยแพร่แล้ว ห้ามแก้เนื้อหา ใช้เปิดรอบงานได้']
  ARCHIVED [note: 'ถูกแทนที่ด้วยฉบับใหม่ ยังใช้อ้างอิงคำตอบ/รอบเก่าได้']
}


Enum form_field_type {
  TEXT [note: 'ข้อความสั้น/ยาว']
  NUMBER [note: 'ตัวเลข อาจมีหน่วยใน config']
  SELECT [note: 'เลือกจากตัวเลือกที่กำหนดใน config.options']
  BOOLEAN [note: 'ใช่/ไม่ใช่ เหมาะกับเช็กลิสต์']
  DATE [note: 'วันที่']
  IMAGE [note: 'แนบรูปภาพ เก็บผ่าน form_answer_attachment']
  FILE [note: 'แนบไฟล์ เก็บผ่าน form_answer_attachment']
}


Enum form_schedule_kind {
  RECURRING [note: 'เปิดรอบซ้ำตามความถี่ที่ตั้งใน schedule_config']
  EXPLICIT [note: 'เปิดรอบตามช่วงเวลาที่ระบุเองใน form_plan_period']
}


Enum form_review_mode {
  NONE [note: 'ไม่มีขั้นตอนตรวจ']
  OVERALL [note: 'ตรวจและตัดสินทั้งชุดคำตอบครั้งเดียว']
  ALL_SECTIONS [note: 'ต้องตรวจครบทุกหมวดก่อนตัดสินทั้งชุด']
  ALL_ANSWERS [note: 'ต้องตรวจครบทุกคำตอบก่อนตัดสินทั้งชุด']
}


Enum form_role_distribution {
  SHARED [note: 'สมาชิกใน Role ร่วมกันทำงานชุดเดียว']
  PER_MEMBER [note: 'แจกงานแยกให้สมาชิกแต่ละคนในบัดนั้น']
}


Enum form_late_policy {
  ALLOW [note: 'ยังส่งคำตอบได้แม้เลย due_at']
  DENY [note: 'ห้ามส่งคำตอบหลังพ้น due_at']
}


Enum form_missed_policy {
  SKIP [note: 'รอบที่ไม่ได้เปิด/พลาดจะข้ามไปเลย']
  CATCH_UP [note: 'สร้างรอบย้อนหลังให้ครบตามกำหนดการ']
}


Enum form_review_action {
  PASS [note: 'ผ่าน ใช้กับคำตอบ/หมวดรายรายการ']
  NEEDS_CHANGES [note: 'ต้องแก้ไข ใช้กับคำตอบ/หมวดรายรายการ ต้องมี note']
  APPROVE [note: 'อนุมัติทั้งชุด เป็นคำตัดสินสุดท้าย']
  RETURN [note: 'ตีกลับทั้งชุดให้แก้ไข เปิดทางสร้าง submission รอบใหม่']
}


Table form_template {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id เจ้าของฟอร์ม']
  name text [not null, note: 'ชื่อแม่แบบ ใช้แสดงในรายการฟอร์ม']
  description text [note: 'คำอธิบายวัตถุประสงค์ของฟอร์ม']
  is_active boolean [not null, default: true, note: 'ปิดใช้งานแทนลบเมื่อมีประวัติการใช้งาน']
  created_by uuid [not null, note: 'company_member ของบริษัทเจ้าของฟอร์ม']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (id, company_id) [unique]
    (company_id, is_active)
  }

  Note: 'PROPOSED: ตัวตนของฟอร์ม; ปิดใช้งานแทนลบเมื่อมีประวัติ'
}

Table form_version {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  form_template_id uuid [not null, note: 'FK -> form_template.id แม่แบบเจ้าของฉบับนี้']
  version integer [not null, check: `version > 0`, note: 'เลขฉบับรันตามลำดับต่อแม่แบบ ไม่ลดหรือใช้ซ้ำ']
  status form_version_status [not null, default: 'DRAFT', note: 'สถานะวงจรฉบับ: DRAFT/PUBLISHED/ARCHIVED']
  title text [not null, note: 'ชื่อในฉบับที่เผยแพร่ เป็นเนื้อหาประวัติไม่เปลี่ยนตามชื่อแม่แบบ']
  description text [note: 'คำอธิบายเนื้อหาของฉบับนี้']
  created_by uuid [not null, note: 'company_member ผู้สร้างฉบับนี้']
  published_by uuid [note: 'company_member ผู้กดเผยแพร่ (Nullable ก่อนเผยแพร่)']
  published_at timestamptz [note: 'เวลาที่เผยแพร่ฉบับนี้']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (id, company_id) [unique]
    (id, company_id, form_template_id) [unique, note: 'บังคับแผนและรอบงานเลือกฉบับของฟอร์มเดียวกัน']
    (form_template_id, version) [unique]
    (company_id, status)
  }

  checks {
    `(status = 'DRAFT' AND published_at IS NULL AND published_by IS NULL) OR (status IN ('PUBLISHED', 'ARCHIVED') AND published_at IS NOT NULL AND published_by IS NOT NULL)` [name: 'form_version_publish_metadata_check']
  }

  Note: 'PROPOSED: Publish แล้ว title/description/sections/fields/config ห้ามแก้; ARCHIVED ยังใช้กับคำตอบเดิมและรอบแก้ไขเดิมได้; publish ใหม่ archive ตัวเก่าใน transaction เดียว; partial unique ไม่เกิน 1 DRAFT และ 1 PUBLISHED/template ต้องเพิ่มใน migration ตามเอกสาร'
}

Table form_section {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  form_version_id uuid [not null, note: 'FK -> form_version.id ฉบับที่หมวดนี้อยู่']
  title text [not null, note: 'ชื่อหมวดคำถาม']
  description text [note: 'คำอธิบายหมวดคำถาม']
  sort_order integer [not null, default: 0, check: `sort_order >= 0`, note: 'ลำดับแสดงผลของหมวดในฉบับ']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (id, company_id, form_version_id) [unique]
    (form_version_id, sort_order)
  }

  Note: 'PROPOSED: ลำดับแสดงผลใช้ sort_order, id; ย้ายลำดับได้เฉพาะ DRAFT'
}

Table form_field {
  id uuid [pk, note: 'UUIDv7; clone version สร้าง id ใหม่']
  company_id uuid [not null, note: 'FK -> company.id']
  form_version_id uuid [not null, note: 'FK -> form_version.id ฉบับที่คำถามนี้อยู่']
  form_section_id uuid [not null, note: 'FK -> form_section.id หมวดที่คำถามนี้อยู่']
  name text [not null, note: 'รหัสหรือชื่อตัวแปรของคำถาม']
  type form_field_type [not null, note: 'ชนิดคำถาม']
  label text [not null, note: 'ข้อความคำถามที่แสดงให้ผู้ตอบเห็น']
  description text [note: 'คำอธิบาย/คำแนะนำเพิ่มเติมของคำถาม']
  placeholder text [note: 'ข้อความตัวอย่าง']
  is_required boolean [not null, default: false, note: 'บังคับตอบก่อน submit หรือไม่']
  min double [note: 'ค่าต่ำสุด (ตัวเลข)']
  max double [note: 'ค่าสูงสุด (ตัวเลข)']
  min_length integer [note: 'ความยาวต่ำสุด (ตัวอักษร)']
  max_length integer [note: 'ความยาวสูงสุด (ตัวอักษร)']
  sort_order integer [not null, default: 0, check: `sort_order >= 0`, note: 'ลำดับแสดงผลของคำถามในหมวด']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (id, company_id, form_version_id) [unique]
    (form_section_id, sort_order)
  }

  Note: 'PROPOSED: Normalized field attributes แทน config JSONB'
}

Table form_field_option {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  form_version_id uuid [not null, note: 'FK -> form_version.id']
  field_id uuid [not null, note: 'FK -> form_field.id onDelete cascade']
  label text [not null, note: 'ข้อความตัวเลือก']
  value text [not null, note: 'ค่าตัวเลือก']
  sort_order integer [not null, default: 0, check: `sort_order >= 0`, note: 'ลำดับตัวเลือก']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (id, company_id, form_version_id) [unique]
    (field_id, sort_order)
  }

  Note: 'PROPOSED: ตัวเลือกคำถามสำหรับ SELECT, RADIO, CHECKBOX_GROUP แยกเป็นตาราง relational'
}

Table form_plan {
  id uuid [pk, note: 'รหัสชุดการตั้งค่าแผน UUIDv7; เมื่อแก้แผนที่เปิดใช้แล้วให้สร้างชุดถัดไป']
  company_id uuid [not null, note: 'FK -> company.id']
  form_template_id uuid [not null, note: 'FK -> form_template.id แม่แบบที่แผนนี้ใช้']
  supersedes_plan_id uuid [unique, note: 'ชุดการตั้งค่าก่อนหน้าในแผนเดียวกัน ไม่ใช่แผนใหม่ที่ผู้ใช้ต้องจัดการแยก']
  name text [not null]
  schedule_kind form_schedule_kind [not null]
  schedule_config jsonb [note: 'RECURRING เท่านั้น: frequency, interval, local anchor, weekdays/day/month, invalid-day policy, due offset และหน่วย; ตรวจรูปแบบด้วย Zod']
  timezone text [not null, note: 'ชื่อเขตเวลา IANA ใช้ตีความปฏิทิน เช่น Asia/Bangkok']
  fixed_version_id uuid [note: 'มีค่า = ล็อกฉบับนี้; ไม่มีค่า = เลือกฉบับเผยแพร่ล่าสุดตอนเปิดรอบ ไม่เก็บ version_mode ซ้ำ']
  review_mode form_review_mode [not null, default: 'OVERALL']
  late_policy form_late_policy [not null, default: 'DENY']
  missed_policy form_missed_policy [not null, default: 'SKIP']
  effective_from timestamptz [note: 'เริ่มช่วงเปิดใช้; null คือยังไม่เคยเปิดใช้งาน ไม่ต้องมี is_enabled ซ้ำ']
  effective_until timestamptz [note: 'สิ้นสุดช่วงแบบไม่รวมขอบ เวลา pause หรือเริ่ม config ถัดไป; null คือยังไม่กำหนดสิ้นสุด']
  created_by uuid [not null, note: 'company_member ผู้สร้างแผนนี้']
  closed_by uuid [note: 'ผู้สั่งปิดช่วงใช้งานเมื่อมี manual action; ไม่ใช่ actor ปลอมของ worker']
  revision integer [not null, default: 1, check: `revision > 0`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  Indexes {
    (id, company_id) [unique]
    (id, company_id, form_template_id) [unique]
    (company_id, effective_from, effective_until)
  }

  checks {
    `(schedule_kind = 'RECURRING' AND schedule_config IS NOT NULL AND jsonb_typeof(schedule_config) = 'object') OR (schedule_kind = 'EXPLICIT' AND schedule_config IS NULL)` [name: 'form_plan_schedule_check']
    `effective_until IS NULL OR (effective_from IS NOT NULL AND effective_until > effective_from)` [name: 'form_plan_effective_check']
    `supersedes_plan_id IS NULL OR supersedes_plan_id <> id` [name: 'form_plan_no_self_check']
    `closed_by IS NULL OR effective_until IS NOT NULL` [name: 'form_plan_closed_actor_check']
  }

  Note: 'แบบเสนอ: หนึ่งแถวคือกติกาแผนหนึ่งช่วงเวลา เก็บประวัติด้วย successor เมื่อแก้เวลา ผู้รับ หรือ policy หลังเปิดใช้ ช่วง effective เป็นคำสั่งธุรกิจ ไม่ใช่ cache; use case กันช่วงทับและ cycle ในสายแผน การ pause ปิดช่วงเดิม resume สร้างช่วงใหม่ ไม่เปิดย้อนหลังในช่วงที่ตั้งใจหยุด'
}

Table form_plan_target {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  plan_id uuid [not null, note: 'FK -> form_plan.id แผนที่กำหนดผู้รับนี้']
  role_id uuid [note: 'ใช้ Role ของ tenant หรือ system default ที่ระบบอนุญาต; use case ตรวจ scope เพราะ role.company_id nullable']
  company_member_id uuid [note: 'สมาชิกรายบุคคลที่เป็นผู้รับ เลือกอย่างใดอย่างหนึ่งกับ role_id']
  role_distribution form_role_distribution [note: 'มีค่าเฉพาะเป้าหมาย Role: SHARED ร่วมทำหนึ่งชุด, PER_MEMBER แจกคนละงาน']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (plan_id, role_id) [unique]
    (plan_id, company_member_id) [unique]
  }

  checks {
    `(role_id IS NOT NULL AND company_member_id IS NULL AND role_distribution IS NOT NULL) OR (role_id IS NULL AND company_member_id IS NOT NULL AND role_distribution IS NULL)` [name: 'form_plan_target_xor_check']
  }

  Note: 'แบบเสนอ: รายการผู้รับที่ใช้สร้างงานในอนาคต ไม่ใช่ผู้รับจริงของรอบเก่า แก้ได้เมื่อแผนยังไม่เปิดใช้ หลังเปิดแล้ว clone ไป config ถัดไป เก็บแยกจาก Assignment เพราะสมาชิก Role เปลี่ยนได้'
}

Table form_plan_period {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  plan_id uuid [not null, note: 'FK -> form_plan.id แผนที่ใช้ช่วงเวลานี้ (ต้องเป็น EXPLICIT)']
  opens_at timestamptz [not null, note: 'เวลาเปิดให้ทำงาน']
  due_at timestamptz [not null, note: 'เวลาครบกำหนดส่ง']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (id, company_id, plan_id) [unique]
    (plan_id, opens_at, due_at) [unique]
  }

  checks {
    `due_at > opens_at` [name: 'form_plan_period_time_check']
  }

  Note: 'แบบเสนอ: ช่วงเวลาที่ผู้ใช้ระบุเอง หนึ่งครั้งคือหนึ่งแถว หลายช่วงคือหลายแถว ใช้กับ EXPLICIT เท่านั้นตาม use case ไม่เก็บรอบ recurring ล่วงหน้าในตารางนี้ หลังเปิดใช้แผนห้ามแก้ช่วงเก่า'
}

Table form_occurrence {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  plan_id uuid [not null, note: 'FK -> form_plan.id แผนที่เปิดรอบนี้']
  form_template_id uuid [not null, note: 'เก็บเพื่อ composite FK บังคับ plan และ version เป็นฟอร์มเดียวกัน ไม่ใช่ cache']
  form_version_id uuid [not null, note: 'ฉบับคำถามที่ใช้กับรอบนี้ (มาจาก fixed_version_id หรือฉบับเผยแพร่ล่าสุด)']
  period_id uuid [note: 'มีค่าเฉพาะ explicit period ของ plan เดียวกัน; recurring ใช้ occurrence_key']
  occurrence_key text [not null, note: 'รหัสรอบตามปฏิทินและ offset หรือ period ID เพื่อกัน retry ซ้ำ ไม่ใช่เวลา worker ทำงาน']
  opens_at timestamptz [not null, note: 'เวลาเปิดตามรอบ; created_at คือเวลาเปิดบันทึกจริงหาก worker ล่าช้า']
  due_at timestamptz [not null, note: 'เวลาครบกำหนดส่งของรอบนี้']
  cancelled_at timestamptz [note: 'เวลาที่ยกเลิกรอบนี้ (null = ยังไม่ถูกยกเลิก)']
  cancelled_by uuid [note: 'company_member ผู้สั่งยกเลิก']
  cancel_reason text [note: 'เหตุผลการยกเลิก บังคับเมื่อมี cancelled_at']
  revision integer [not null, default: 1, check: `revision > 0`, note: 'เลขระบุการแก้ไขของรอบ ไม่ใช่ยอดงานสะสม']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (id, company_id) [unique]
    (id, company_id, form_version_id) [unique]
    (plan_id, occurrence_key) [unique]
    (plan_id, period_id) [unique]
    (company_id, opens_at)
  }

  checks {
    `due_at > opens_at` [name: 'form_occurrence_time_check']
    `(cancelled_at IS NULL AND cancelled_by IS NULL AND cancel_reason IS NULL) OR (cancelled_at IS NOT NULL AND cancelled_by IS NOT NULL AND cancel_reason IS NOT NULL AND length(trim(cancel_reason)) > 0)` [name: 'form_occurrence_cancel_check']
  }

  Note: 'แบบเสนอ: รอบงานที่เปิดจริง ล็อกฉบับคำถามและเวลาที่นำไปใช้ ไม่คัดลอก review/late policy ซ้ำเพราะอ้าง plan config ที่เก็บประวัติและห้ามแก้แล้ว การยกเลิกรอบมีผลต่อทุกงานลูกโดยคำนวณ ไม่เขียน cancelled ซ้ำทุก Assignment; ไม่มีสถานะหรือยอดงานสะสม'
}

Table form_assignment {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  occurrence_id uuid [not null, note: 'FK -> form_occurrence.id รอบงานที่มอบหมายนี้']
  form_version_id uuid [not null, note: 'จำเป็นสำหรับ composite FK ให้คำตอบทุก revision ใช้ฉบับของรอบเดียวกัน']
  role_id uuid [note: 'Role ผู้รับงาน (ร่วมทำ) เลือกอย่างใดอย่างหนึ่งกับ company_member_id']
  company_member_id uuid [note: 'สมาชิกผู้รับงานส่วนตัว เลือกอย่างใดอย่างหนึ่งกับ role_id']
  replaces_assignment_id uuid [unique, note: 'งานเดิมที่ถูกยกเลิกและมอบหมายใหม่ ไม่ย้ายคำตอบเก่ามาเป็นของผู้รับใหม่']
  assigned_by uuid [note: 'null เมื่อสร้างอัตโนมัติจากแผน; มีค่าเมื่อผู้ใช้มอบหมายทดแทนจริง']
  cancelled_at timestamptz [note: 'เวลาที่ยกเลิกงานนี้']
  cancelled_by uuid [note: 'company_member ผู้สั่งยกเลิกงาน']
  cancel_reason text [note: 'เหตุผลการยกเลิกงาน']
  revision integer [not null, default: 1, check: `revision > 0`, note: 'เลขระบุการแก้ไขของงานมอบหมายนี้']
  created_at timestamptz [not null, default: `now()`, note: 'เวลามอบหมายจริง ไม่เพิ่ม assigned_at ซ้ำ']
  Indexes {
    (id, company_id, form_version_id) [unique]
    (id, company_id, occurrence_id) [unique]
    (company_id, company_member_id, created_at)
    (company_id, role_id, created_at)
  }

  checks {
    `num_nonnulls(role_id, company_member_id) = 1` [name: 'form_assignment_target_check']
    `replaces_assignment_id IS NULL OR replaces_assignment_id <> id` [name: 'form_assignment_no_self_check']
    `(cancelled_at IS NULL AND cancelled_by IS NULL AND cancel_reason IS NULL) OR (cancelled_at IS NOT NULL AND cancelled_by IS NOT NULL AND cancel_reason IS NOT NULL AND length(trim(cancel_reason)) > 0)` [name: 'form_assignment_cancel_check']
  }

  Note: 'แบบเสนอ: ผู้รับงานจริงของรอบ Role คือร่วมทำ ส่วน member คือส่วนตัว PER_MEMBER ขยายรายชื่อตอนเปิดจริงและรวมสมาชิกซ้ำแล้ว ไม่เก็บ target_type หรือ distribution ซ้ำในงานจริง ต้องมี partial unique ของผู้รับที่ยังไม่ถูกยกเลิกใน migration เพื่ออนุญาต replacement โดยรักษาประวัติ'
}


Table form_submission {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  assignment_id uuid [not null, note: 'FK -> form_assignment.id งานที่ชุดคำตอบนี้สังกัด']
  form_version_id uuid [not null, note: 'ฉบับคำถามที่ใช้ตอบ ล็อกตาม assignment/occurrence']
  started_by uuid [not null, note: 'สมาชิกผู้เริ่มชุดคำตอบ/รอบแก้ไข; ไม่ใช่เจ้าของคำตอบทั้งหมดหรือผู้ส่งโดยอัตโนมัติ']
  submitted_by uuid [note: 'สมาชิกผู้กดส่งจริง; NULL ระหว่าง DRAFT; ผู้รับแบบ member หรือสมาชิก Role ของ Assignment ที่มี permission ส่งได้']
  revision integer [not null, default: 1, check: `revision > 0`, note: 'Optimistic concurrency ทั้งชุด; ทุก mutation ต้องเทียบ expected_revision และเพิ่มค่าใน transaction']
  supersedes_submission_id uuid [unique, note: 'รอบแก้ไขชี้ไป RETURN เดิม; หนึ่งรอบเดิมมีรอบถัดไปได้หนึ่งเดียว']
  submitted_at timestamptz [note: 'เวลาที่กดส่งจริง; null คือยังเป็น DRAFT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (id, company_id, form_version_id) [unique]
    (id, company_id, form_version_id, assignment_id) [unique, note: 'บังคับ revision ถัดไปอยู่ Assignment และฉบับเดิม']
    (id, company_id) [unique]
    (company_id, submitted_at)
    (company_id, assignment_id)
    (company_id, started_by, created_at)
    (company_id, submitted_by, created_at)
    form_version_id
  }

  checks {
    `(submitted_at IS NULL) = (submitted_by IS NULL)` [name: 'form_submission_status_time_check']
    `submitted_at IS NULL OR submitted_at >= created_at` [name: 'form_submission_time_order_check']
    `supersedes_submission_id IS NULL OR supersedes_submission_id <> id` [name: 'form_submission_no_self_revision_check']
  }

  Note: 'แบบเสนอ: ชุดคำตอบหนึ่ง revision ของ Assignment ไม่ผูกสิทธิ์กับผู้เริ่มหรือ contributor หลังส่งล็อกเนื้อหาและไฟล์ RETURN แล้วสร้าง successor พร้อมคงหลักฐานเดิม; revision เป็น concurrency token ของการบันทึกและตรวจ ไม่ใช่เลขรอบ ต้องมี partial unique root ต่อ Assignment ใน migration'
}

Table form_submission_contributor {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  submission_id uuid [not null, note: 'FK -> form_submission.id ชุดคำตอบที่มีส่วนร่วม']
  member_id uuid [not null, note: 'สมาชิกผู้เคยเริ่ม/แก้คำตอบ/จัดการไฟล์/ส่งชุดคำตอบ; ไม่ใช่รายการสิทธิ์เข้าถึง']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (submission_id, member_id) [unique]
    (company_id, member_id)
  }

  Note: 'PROPOSED: บันทึกผู้มีส่วนร่วมครั้งแรกใน transaction เดียวกับการเขียน; ห้ามลบเมื่อคำตอบถูกแก้/ลบหรือสมาชิกเปลี่ยน role; clone ทุกแถวจากรอบเดิมเพื่อประเมิน permission ตรวจงานตนเองตลอดประวัติ; ไม่มีค่าเก่าของคำตอบและไม่ใช้เป็น ACL'
}

Table form_answer {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  form_version_id uuid [not null, note: 'Composite FKs บังคับ submission และ field อยู่ version เดียวกัน']
  submission_id uuid [not null, note: 'FK -> form_submission.id ชุดคำตอบที่คำตอบนี้สังกัด']
  field_id uuid [not null, note: 'FK -> form_field.id คำถามที่คำตอบนี้ตอบ']
  value jsonb [note: 'Scalar/array ตาม field type; SQL NULL = ยังไม่ตอบ หรือคำตอบแบบไฟล์ที่อยู่ใน attachment']
  updated_by uuid [not null, note: 'สมาชิกผู้แก้คำตอบ/รายการไฟล์ล่าสุด; ต่างจากผู้กดส่ง; clone คง actor เดิมจนมีคนแก้จริง']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (id, company_id) [unique]
    (id, company_id, submission_id) [unique, note: 'บังคับ review รายข้ออ้างคำตอบของ submission เดียวกัน']
    (submission_id, field_id) [unique]
    (company_id, field_id)
  }

  Note: 'PROPOSED: DRAFT ตอบไม่ครบได้; submit ต้องตรวจ required/type/options/limits กับ published definition; false และ 0 เป็นคำตอบที่มีค่า'
}

Table form_answer_attachment {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  answer_id uuid [not null, note: 'FK -> form_answer.id คำตอบที่แนบไฟล์นี้อยู่']
  storage_key text [not null, note: 'Immutable object key ภายใน namespace ของ company; ไม่เก็บ signed URL']
  original_name text [not null]
  mime_type text [not null]
  size_bytes bigint [not null, check: `size_bytes > 0`]
  sort_order integer [not null, default: 0, check: `sort_order >= 0`]
  uploaded_by uuid [not null, note: 'สมาชิกผู้อัปโหลดจริง; clone คง actor เดิม ไม่เปลี่ยนเป็นผู้ clone/ผู้ส่ง']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (answer_id, storage_key) [unique]
    (answer_id, sort_order)
    (company_id, storage_key)
  }

  Note: 'PROPOSED: IMAGE/FILE ใช้ metadata นี้; clone คำตอบอ้าง object เดิมได้ จึงไม่ unique storage_key ทั้งระบบ; ลบ object เมื่อไม่มี reference และผ่าน retention เท่านั้น'
}

Table form_review_entry {
  id uuid [pk, note: 'UUIDv7']
  company_id uuid [not null, note: 'FK -> company.id']
  submission_id uuid [not null, note: 'FK -> form_submission.id ชุดคำตอบที่ถูกตรวจ']
  form_version_id uuid [not null, note: 'บังคับเป้าหมายหมวดและ submission อยู่ฉบับเดียวกันด้วย composite FK']
  answer_id uuid [note: 'มีค่าเมื่อตรวจคำตอบรายข้อ รวมข้อแนบภาพ']
  section_id uuid [note: 'มีค่าเมื่อตรวจทั้งหมวด; ห้ามมีพร้อม answer_id']
  action form_review_action [not null, note: 'ผลการตรวจ: PASS/NEEDS_CHANGES (รายข้อ/หมวด) หรือ APPROVE/RETURN (ทั้งชุด)']
  note text [note: 'คำอธิบาย/คำแนะนำ บังคับเมื่อ NEEDS_CHANGES หรือ RETURN ไม่ใช่เธรดสนทนา']
  reviewed_by uuid [not null, note: 'สมาชิกผู้ตรวจจริง ตรวจ Role permissions ปัจจุบัน ไม่บังคับ OWNER']
  supersedes_entry_id uuid [unique, note: 'ผลตรวจรายละเอียดที่ถูกแทน ต้องเป็น head ของเป้าหมายเดิม ตรวจด้วย transaction']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (id, company_id, submission_id) [unique]
    (submission_id, answer_id, created_at)
    (submission_id, section_id, created_at)
    (company_id, reviewed_by, created_at)
  }

  checks {
    `(num_nonnulls(answer_id, section_id) = 1 AND action IN ('PASS', 'NEEDS_CHANGES')) OR (answer_id IS NULL AND section_id IS NULL AND action IN ('APPROVE', 'RETURN') AND supersedes_entry_id IS NULL)` [name: 'form_review_target_action_check']
    `action NOT IN ('NEEDS_CHANGES', 'RETURN') OR (note IS NOT NULL AND length(trim(note)) > 0)` [name: 'form_review_note_check']
    `supersedes_entry_id IS NULL OR supersedes_entry_id <> id` [name: 'form_review_no_self_check']
  }

  Note: 'แบบเสนอ: ประวัติผลตรวจแบบเพิ่มอย่างเดียว รายข้อ/หมวดไม่ส่งงานกลับทันที ต้องมี RETURN ทั้งชุด ไม่มีตาราง review แบบหนึ่งต่อหนึ่ง ไม่มีสถานะตรวจซ้ำ ต้องเพิ่ม partial unique สำหรับ root ผลรายเป้าและคำตัดสินสุดท้ายใน migration; permission, coverage, head เป้าหมายเดิม และห้ามตรวจหลัง finalize บังคับใน use case'
}


