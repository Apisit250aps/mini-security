{
  "explorer.compactFolders": false,
  "files.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/out": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/.fallow": true,
    "**/out": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.*.ts",
    "*.tsx": "${capture}.*.tsx",
    "*.js": "${capture}.*.js",
    "*.jsx": "${capture}.*.jsx",
    "*.json": "${capture}.*.json",
    "*.css": "${capture}.*.css",
    ".env": "${capture}.*",
    ".fallow": "${capture}.*",
    "*.config.{js,ts,json}": "${capture}.*.config.{js,ts,json}",
    "*.test.ts": "${capture}.*.test.ts",
    "*.test.js": "${capture}.*.test.js"
  }
}