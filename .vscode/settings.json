{
  "explorer.compactFolders": false,
  "files.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/out": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/.fallow": true,
    "**/out": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.test.ts,${capture}.spec.ts,${capture}.*.ts",
    "*.tsx": "${capture}.test.tsx,${capture}.spec.tsx,${capture}.*.tsx",
    "*.js": "${capture}.test.js,${capture}.spec.js,${capture}.*.js",
    "*.jsx": "${capture}.test.jsx,${capture}.spec.jsx,${capture}.*.jsx",
    "*.json": "${capture}.*.json",
    "*.css": "${capture}.*.css",
    ".env": "${capture}.*",
    ".fallow": "${capture}.*"
  }
}