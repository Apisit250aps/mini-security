{
  "name": "mini-security",
  "private": true,
  "scripts": {
    "build": "dotenv -e .env turbo run build",
    "dev": "dotenv -e .env turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "turbo": "^2.10.11",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.17.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "argon2@0.41.1": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
