# Copy this file to .env before running local development.
NODE_ENV=development

# PostgreSQL on the host machine (database must already exist)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/security

# API (PORT is service-specific and supplied by each Docker image)
BACKEND_PORT=8000
BACKEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Browser-facing auth URL
BETTER_AUTH_SECRET=super-secret-key-please-change-in-production
BETTER_AUTH_URL=http://localhost:8000

# Public Docker reverse proxy port
NGINX_PORT=8080
